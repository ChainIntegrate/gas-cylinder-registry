{
  "keyFile": "/etc/gcr-relayer/relayer.key",
  "listen": {
    "host": "127.0.0.1",
    "port": 8789
  },
  "rpcFile": "/etc/gcr-relayer/rpc-url",
  "chainId": 42,
  "factory": "0x0000000000000000000000000000000000000000",
  "allowedOrigins": [
    "https://localhost",
    "capacitor://localhost",
    "https://gastrace.chainintegrate.it"
  ],
  "minBalanceWarn": "0.5",
  "limits": {
    "perIpPerMinute": 20,
    "perRegistryPerDay": 300,
    "maxMints": 25,
    "maxUpdates": 60
  }
}
